{
  // Verificação de tipos do JavaScript (ADR 0004). Não gera arquivos.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["*.js", "types/**/*.d.ts"]
}

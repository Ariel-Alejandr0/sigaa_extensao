{
  "name": "sigaa-agenda",
  "version": "2.1.0",
  "private": true,
  "description": "Extensão de navegador que leva avaliações e tarefas do SIGAA do IFC para o Google Agenda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ariel-Alejandr0/sigaa_extensao.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "echo \"Ainda não há build (fase 3 do roadmap): carregue a pasta direto no Chrome.\" && exit 1",
    "package": "echo \"Ainda não há empacotamento (fase 5 do roadmap).\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "ical.js": "^2.2.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
